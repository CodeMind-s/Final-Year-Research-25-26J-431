{
  "name": "@brinex-server/lab-agent",
  "version": "0.0.1",
  "private": true,
  "nx": {
    "name": "@brinex-server/lab-agent",
    "targets": {
      "build": {
        "executor": "nx:run-commands",
        "options": {
          "command": "npx webpack-cli build",
          "args": [
            "--node-env=production"
          ],
          "cwd": "apps/lab-agent"
        },
        "configurations": {
          "development": {
            "args": [
              "--node-env=development"
            ]
          }
        }
      },
      "prune-lockfile": {
        "dependsOn": [
          "build"
        ],
        "cache": true,
        "executor": "@nx/js:prune-lockfile",
        "outputs": [
          "{workspaceRoot}/apps/lab-agent/dist/package.json",
          "{workspaceRoot}/apps/lab-agent/dist/package-lock.json"
        ],
        "options": {
          "buildTarget": "build"
        }
      },
      "copy-workspace-modules": {
        "dependsOn": [
          "build"
        ],
        "cache": true,
        "outputs": [
          "{workspaceRoot}/apps/lab-agent/dist/workspace_modules"
        ],
        "executor": "@nx/js:copy-workspace-modules",
        "options": {
          "buildTarget": "build"
        }
      },
      "prune": {
        "dependsOn": [
          "prune-lockfile",
          "copy-workspace-modules"
        ],
        "executor": "nx:noop"
      },
      "serve": {
        "continuous": true,
        "executor": "@nx/js:node",
        "defaultConfiguration": "development",
        "dependsOn": [
          "build"
        ],
        "options": {
          "buildTarget": "@brinex-server/lab-agent:build",
          "runBuildTargetDependencies": false,
          "inspect": true,
          "port": 9244
        },
        "configurations": {
          "development": {
            "buildTarget": "@brinex-server/lab-agent:build:development"
          },
          "production": {
            "buildTarget": "@brinex-server/lab-agent:build:production"
          }
        }
      },
      "test": {
        "options": {
          "passWithNoTests": true
        }
      },
      "build-electron": {
        "executor": "nx:run-commands",
        "dependsOn": [
          "build"
        ],
        "outputs": [
          "{workspaceRoot}/dist/apps/lab-agent/electron"
        ],
        "options": {
          "command": "npx tsc -p apps/lab-agent/electron/tsconfig.json"
        }
      },
      "package": {
        "executor": "nx:run-commands",
        "dependsOn": [
          "build",
          "build-electron"
        ],
        "options": {
          "commands": [
            "npx electron-builder --config apps/lab-agent/electron-builder.yml --win"
          ],
          "parallel": false
        }
      }
    }
  },
  "dependencies": {
    "@nestjs/common": "^11.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/platform-express": "^11.0.0",
    "@nestjs/platform-socket.io": "^11.1.6",
    "@nestjs/websockets": "^11.1.13",
    "axios": "^1.6.0",
    "jose": "^5.9.6",
    "reflect-metadata": "^0.1.13",
    "rxjs": "^7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@nestjs/testing": "^11.0.0",
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "electron-updater": "^6.3.9",
    "socket.io-client": "^4.8.0"
  }
}

# Test Environment Configuration Example
# Copy this file to .env.test and update with your local values

# MongoDB Configuration
MONGO_URI=mongodb://root:testpassword@localhost:27017/compass-test?authSource=admin

# gRPC Configuration
GRPC_URL=0.0.0.0:50052

# Kafka Configuration (Optional for integration tests)
KAFKA_BROKER=localhost:9092

# Application Environment
NODE_ENV=test

# JWT Secret for testing
JWT_SECRET=test-secret-key-for-testing-only-change-in-production

# API Gateway URL (for integration tests)
API_GATEWAY_URL=http://localhost:3400

# Test User Credentials (Optional)
TEST_USER_EMAIL=testuser@example.com
TEST_USER_PASSWORD=testpassword123

# Logging
LOG_LEVEL=error

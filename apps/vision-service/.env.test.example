# Test Environment Configuration Example
# Copy this file to .env.test and update with your local values

# MongoDB Configuration
MONGO_URI=mongodb://root:testpassword@localhost:27017/vision-test?authSource=admin

# gRPC Configuration
GRPC_URL=0.0.0.0:50057

# Application Environment
NODE_ENV=test

# Vision Model (not needed for tests — mocked)
# VISION_MODEL_PATH=apps/vision-service/models/best.onnx
VISION_INPUT_SIZE=320
VISION_CONFIDENCE_THRESHOLD=0.5
VISION_IOU_THRESHOLD=0.45

# Logging
LOG_LEVEL=error

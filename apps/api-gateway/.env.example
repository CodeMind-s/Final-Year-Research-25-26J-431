PORT=3400

# JWT verification — RS256 mode (preferred, required for Lab Agent / Phase 4):
#   set JWT_PUBLIC_KEY (and on auth-service set JWT_PRIVATE_KEY too).
#   Generate keys with: ./scripts/generate-jwt-keys.ps1
# Legacy HS256 mode (fallback): leave JWT_PUBLIC_KEY unset and use JWT_SECRET.
JWT_SECRET=secret
# JWT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----"
# JWT_ISSUER=brinex-auth

# Kafka Configuration
KAFKA_BROKER=localhost:29092

# gRPC Service URLs
AUTH_SERVICE_URL=localhost:50000
USER_SERVICE_URL=localhost:50053

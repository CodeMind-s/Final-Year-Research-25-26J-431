# =============================================================================
# Azure Deployment Configuration — copy to .env.azure and fill in values
# =============================================================================

# ── Azure Resources ──────────────────────────────────────────────────────────
RESOURCE_GROUP=rg-brinex
LOCATION=southeastasia
ACR_NAME=brinexacr
ACA_ENV=brinex-env
EVENTHUB_NAMESPACE=brinex-kafka
IMAGE_TAG=v1

# ── Azure Container Registry admin password ─────────────────────────────────
# Get with: az acr credential show --name <ACR_NAME> --query passwords[0].value -o tsv
ACR_PASS=

# ── Azure Event Hub (Kafka-compatible) connection string ────────────────────
# Get from Azure Portal → Event Hub Namespace → Shared access policies
EVENTHUB_CONN=

# ── Required Secrets ─────────────────────────────────────────────────────────
MONGO_URI=
JWT_SECRET=

# ── Auth Service (Notify.lk SMS) ─────────────────────────────────────────────
NOTIFY_LK_USER_ID=
NOTIFY_LK_API_KEY=
NOTIFY_LK_SENDER_ID=

# ── Email Service ─────────────────────────────────────────────────────────────
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASSWORD=
EMAIL_FROM=

# ── Payment Service (PayHere) ────────────────────────────────────────────────
PAYHERE_MERCHANT_ID=
PAYHERE_MERCHANT_SECRET=
PAYHERE_SANDBOX=true
PAYHERE_NOTIFY_URL=
FRONTEND_URL=

# ── Crystallization Service (Weather API) ────────────────────────────────────
OPENWEATHER_API_KEY=
OPENWEATHER_LAT=
OPENWEATHER_LON=

# ── Gemini Service ────────────────────────────────────────────────────────────
GEMINI_API_KEY=

# ── Waste Valorization Service (AWS) ─────────────────────────────────────────
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SQS_QUEUE_URL=
AWS_ACCOUNT_ID=
ENVIRONMENT=production

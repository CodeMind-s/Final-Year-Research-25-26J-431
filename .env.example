# Environment Variables for Docker Compose
# Copy this file to .env and fill in your values

NODE_ENV=development

# MongoDB Connection String
MONGO_URI=mongodb+srv://username:password@cluster.mongodb.net/database

# JWT Secret for authentication
JWT_SECRET=your-jwt-secret-key-here

# Notify.lk Configuration (for SMS/OTP)
NOTIFY_LK_USER_ID=your-notify-lk-user-id
NOTIFY_LK_API_KEY=your-notify-lk-api-key
NOTIFY_LK_SENDER_ID=NotifyDEMO

# Stripe Configuration (for payments)
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRODUCT_ID_BASIC=prod_... # From Stripe dashboard
STRIPE_PRICE_ID_BASIC=price_... # $9/mo for Basic
STRIPE_PRODUCT_ID_PREMIUM=prod_... # For Premium
STRIPE_PRICE_ID_PREMIUM=price_... # $19/mo for Premium

# OpenWeatherMap API Configuration
OPENWEATHER_API_KEY=your-openweather-api-key
OPENWEATHER_LAT=8.061542
OPENWEATHER_LON=79.814714

# Open Exchange Rates API
OPEN_EXCHANGE_RATES_API_KEY=your_api_key_here

# Google Cloud Configuration
GOOGLE_APPLICATION_CREDENTIALS="./service-account-key.json"

# Email Service Configuration
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your-email-app-password
EMAIL_FROM=BrineX <noreply@brinex.com>